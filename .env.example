# Auth.js — providers register only when both ID and secret are present.
# Empty placeholders must not crash next build.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=
AUTH_EMAIL_SERVER=
AUTH_EMAIL_FROM=

# Comma-separated allowlist. Founder is seeded ONLY from this list.
# First signup is never Founder. There is no self-serve role switcher.
FOUNDER_EMAILS=

# Optional local preview login (not a role picker). Set AUTH_DEMO=1 and a password.
# Sign-in email still determines Founder via FOUNDER_EMAILS; everyone else is Member.
AUTH_DEMO=
AUTH_DEMO_PASSWORD=

# Leads / ESP. Empty = email capture returns success without persisting. Do not throw.
LEADS_ENDPOINT=
LEADS_API_KEY=
LEADS_LIST_ID=

# Affiliate tags. Empty tags still link the merchant (no broken CTAs).
AFFILIATE_TAG_AMAZON=
AFFILIATE_TAG_SWEETWATER=
AFFILIATE_TAG_THOMANN=
AFFILIATE_TAG_B_AND_H=

# Outbound shop lanes. Empty = placeholder cards only. Never invent live URLs.
SHOPIFY_URL=
SPREADSHOP_URL=

# When set, portal CTAs open this URL in a new tab. Empty = internal /horns-and-halos.
HORNS_AND_HALOS_URL=
