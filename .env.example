# Projectsixxx.com - Environment Variables
# Copy this file to .env.local for local development
# For Vercel: Add these as Environment Variables in Vercel Dashboard

# ============================================
# SITE CONFIGURATION
# ============================================
NEXT_PUBLIC_SITE_URL=https://projectsixxx.com
NEXT_PUBLIC_SITE_NAME="Horns & Halos"
NEXT_PUBLIC_SITE_DESCRIPTION="Streetwear meets Dark Divinity — Gothic Luxury Digital Empire"

# ============================================
# SANITY CMS
# ============================================
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_READ_TOKEN=your_read_token
SANITY_API_WRITE_TOKEN=your_write_token

# ============================================
# DATABASE (Vercel Postgres)
# ============================================
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
POSTGRES_PRISMA_URL=postgresql://user:password@host:5432/dbname?sslmode=require&pgbouncer=true
POSTGRES_URL_NON_POOLING=postgresql://user:password@host:5432/dbname?sslmode=require

# ============================================
# AUTHENTICATION (NextAuth.js)
# ============================================
NEXTAUTH_SECRET=your_super_secret_key_min_32_chars
NEXTAUTH_URL=https://projectsixxx.com
NEXT_PUBLIC_NEXTAUTH_URL=https://projectsixxx.com

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ============================================
# EMAIL (Resend)
# ============================================
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@projectsixxx.com
RESEND_FROM_NAME="Horns & Halos"

# ============================================
# RECAPTCHA (v3 Invisible)
# ============================================
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
RECAPTCHA_MIN_SCORE=0.5

# ============================================
# CALENDLY (Service Booking)
# ============================================
CALENDLY_CLIENT_ID=your_calendly_client_id
CALENDLY_CLIENT_SECRET=your_calendly_client_secret
CALENDLY_REDIRECT_URI=https://projectsixxx.com/api/auth/callback/calendly
NEXT_PUBLIC_CALENDLY_ORG_URI=https://calendly.com/your-org

# ============================================
# PRINT ON DEMAND
# ============================================
# Printful
PRINTFUL_API_KEY=your_printf_api_key
PRINTFUL_STORE_ID=your_store_id

# Gelato
GELATO_API_KEY=your_gelato_api_key
GELATO_STORE_ID=your_store_id

# ============================================
# SEARCH
# ============================================
# Algolia
ALGOLIA_APP_ID=your_algolia_app_id
ALGOLIA_API_KEY=your_algolia_search_only_api_key
ALGOLIA_ADMIN_API_KEY=your_algolia_admin_api_key
NEXT_PUBLIC_ALGOLIA_APP_ID=your_algolia_app_id
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=your_algolia_search_only_api_key

# Meilisearch (Alternative)
MEILISEARCH_HOST=https://your-meilisearch-host
MEILISEARCH_API_KEY=your_meilisearch_api_key

# ============================================
# SHOPIFY (HnH Primary Shop)
# ============================================
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your_storefront_token
SHOPIFY_ADMIN_API_TOKEN=your_admin_api_token
SHOPIFY_WEBHOOK_SECRET=your_webhook_secret

# ============================================
# AFFILIATE APIs
# ============================================
SPREADSHIRT_API_KEY=your_spreadshirt_key
THREADLESS_API_KEY=your_threadless_key
ETSY_API_KEY=your_etsy_key
ETSY_API_SECRET=your_etsy_secret

# ============================================
# ANALYTICS & MONITORING
# ============================================
# Vercel Analytics (Auto-enabled on Vercel)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=auto

# Plausible Analytics (Privacy-first)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=projectsixxx.com
NEXT_PUBLIC_PLAUSIBLE_API_HOST=https://plausible.io
PLAUSIBLE_API_HOST=https://plausible.io
PLAUSIBLE_DOMAIN=projectsixxx.com

# Sentry (Error Tracking & Performance)
SENTRY_DSN=https://your_dsn@sentry.io/project_id
SENTRY_ORG=your_org
SENTRY_PROJECT=projectsixxx
NEXT_PUBLIC_SENTRY_DSN=https://your_dsn@sentry.io/project_id
SENTRY_AUTH_TOKEN=your_auth_token

# PostHog (Session Replay & Feature Flags)
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=your_posthog_api_key
POSTHOG_HOST=https://us.i.posthog.com

# ============================================
# FEATURE FLAGS
# ============================================
NEXT_PUBLIC_ENABLE_SHOP=true
NEXT_PUBLIC_ENABLE_SERVICES=true
NEXT_PUBLIC_ENABLE_GALLERY=true
NEXT_PUBLIC_ENABLE_JOURNAL=true
NEXT_PUBLIC_ENABLE_ACCOUNT=true
NEXT_PUBLIC_ENABLE_AFFILIATES=true
NEXT_PUBLIC_ENABLE_DARK_MODE=true
NEXT_PUBLIC_ENABLE_REDUCED_MOTION=true

# ============================================
# PERFORMANCE & OPTIMIZATION
# ============================================
NEXT_PUBLIC_ENABLE_BUNDLE_ANALYZER=false
ANALYZE=false

# ============================================
# EDGE MIDDLEWARE
# ============================================
EDGE_CONFIG_ID=your_edge_config_id
NEXT_PUBLIC_EDGE_CONFIG_ID=your_edge_config_id

# ============================================
# CDN & ASSETS
# ============================================
NEXT_PUBLIC_CDN_URL=https://cdn.projectsixxx.com
NEXT_PUBLIC_FONTS_URL=https://fonts.projectsixxx.com
NEXT_PUBLIC_IMAGES_URL=https://images.projectsixxx.com

# ============================================
# DEVELOPMENT
# ============================================
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1